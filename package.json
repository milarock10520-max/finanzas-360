{
  "name": "finanzas-360",
  "version": "1.0.0",
  "description": "Aplicación de gestión financiera personal",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "node scripts/patch-speech-plugin.mjs && node scripts/patch-firebase-google.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/status-bar": "^8.0.2",
    "firebase": "^10.7.1",
    "firebase-admin": "^13.6.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.3",
    "wait-on": "^9.0.10",
    "wrangler": "^4.80.0"
  },
  "build": {
    "appId": "com.finanzas360.desktop",
    "productName": "Finanzas 360",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/client/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
