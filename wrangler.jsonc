{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finanzas-360",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "GOOGLE_TOKENS",
      "id": "5b9dd6a91d2e4a049d3f6fb3f655249a"
    }
  ]
}
